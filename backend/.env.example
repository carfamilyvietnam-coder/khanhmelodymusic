FLASK_ENV=development
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/khanhmelody
SECRET_KEY=<generate-a-random-secret-at-least-32-characters>
JWT_SECRET_KEY=<generate-a-different-random-secret-at-least-32-characters>
R2_BUCKET_NAME=khanhmelody
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key>
R2_SECRET_ACCESS_KEY=<r2-secret-key>
R2_PUBLIC_URL=https://khanhmelody.r2.dev
CORS_ORIGINS=https://khanhmelodymussic.com,https://www.khanhmelodymussic.com,https://khanhmelody-admin.pages.dev

# Use once to create the first administrator, then remove these variables.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
